# Arctos data service. Copy to backend/.env for local work. Never commit real values.

HOST=0.0.0.0
PORT=4000

# Comma separated list of site origins allowed to call the service, for example
# https://arctos-fi.vercel.app,https://www.example.com
# Leave empty in local development. On Vercel leave it empty too: the site and the API share one
# host, which is accepted automatically. A standalone server must set it, because it also
# protects the AI and waitlist endpoints.
FRONTEND_ORIGINS=

# Set to true only when the service runs behind a proxy you control (Fly, Render, nginx).
# It makes rate limiting use the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# AI assistant. Without a key the chat page shows "not configured". The key never reaches the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# PostgreSQL (optional). Gives the waitlist real positions, and lets the trade keeper go on
# managing open snipes across restarts and, on a serverless deployment, while nobody is online.
# On Vercel use a pooler address in transaction mode, for example Supabase's on port 6543.
DATABASE_URL=

# Optional. When set, the keeper's scheduled check only answers callers that send it as a bearer token.
CRON_SECRET=

# Welcome email through an SMTP relay such as Brevo (optional).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Arctos
PUBLIC_SITE_URL=https://your-site.example

# Optional keys that raise provider limits.
COINGECKO_API_KEY=
BLOCKCHAIR_API_KEY=

# Swap and bridge providers that need a key (all free). They stay on the server.
# Relay: dashboard.relay.link. Needed for reliable Relay quotes from 2 October 2026.
RELAY_API_KEY=
# 0x: dashboard.0x.org
ZEROX_API_KEY=
# Squid: request an integrator id through Squid's partnership form.
SQUID_INTEGRATOR_ID=

# Every token and NFT in EVM wallets (free key at dashboard.alchemy.com). Server side only.
ALCHEMY_API_KEY=

# The Alpha page: posts on X from top traders. One key is enough. Server side only.
# twitterapi.io (about $0.15 per 1,000 posts, $1 free credit for new accounts):
TWITTERAPI_IO_KEY=
# Or the official X API (pay per use, about $5 per 1,000 posts):
X_BEARER_TOKEN=
# Who is followed, comma separated handles (a default list of 24 is used when empty).
# ALPHA_ACCOUNTS=blknoiz06,cz_binance,elonmusk,MustStopMurad

# Optional tuning.
# Exchange rate sources for the display currency, tried in order (free, no key).
# FX_SOURCES=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.min.json,https://open.er-api.com/v6/latest/USD
# TRACKED_SYMBOLS=BTC,ETH,BNB,SOL
# WHALE_MIN_USD=100000
# STOCK_WATCHLIST=COIN,MSTR,NVDA
# NEWS_FEEDS=CoinDesk|https://www.coindesk.com/arc/outboundfeeds/rss/,Decrypt|https://decrypt.co/feed
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# BASE_RPC_URL=https://base-rpc.publicnode.com
# ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
# Your own Solana RPC, tried before the free public ones (for example a free Helius endpoint).
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
