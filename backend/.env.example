# Arctos data service. Copy to backend/.env for local work. Never commit real values.

HOST=0.0.0.0
PORT=4000

# Comma separated list of site origins allowed to call the service, for example
# https://arctos-fi.vercel.app,https://www.example.com
# Leave empty only in local development. In production this also protects the AI and waitlist endpoints.
FRONTEND_ORIGINS=

# Set to true only when the service runs behind a proxy you control (Fly, Render, nginx).
# It makes rate limiting use the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# AI assistant. Without a key the chat page shows "not configured". The key never reaches the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Waitlist storage (optional). Without it the waitlist still works but cannot give real positions.
DATABASE_URL=

# Welcome email through an SMTP relay such as Brevo (optional).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Arctos
PUBLIC_SITE_URL=https://your-site.example

# Optional keys that raise provider limits.
COINGECKO_API_KEY=
BLOCKCHAIR_API_KEY=

# Optional tuning.
# TRACKED_SYMBOLS=BTC,ETH,BNB,SOL
# WHALE_MIN_USD=100000
# STOCK_WATCHLIST=COIN,MSTR,NVDA
# NEWS_FEEDS=CoinDesk|https://www.coindesk.com/arc/outboundfeeds/rss/,Decrypt|https://decrypt.co/feed
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# BASE_RPC_URL=https://base-rpc.publicnode.com
# ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
