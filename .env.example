# Web app (Vite). Copy to .env.local for local work.
#
# In development you do not need any of these: Vite proxies /api and /ws to the Rust service
# on http://127.0.0.1:4000. Set VITE_RUST_BACKEND_URL only if the service runs somewhere else.

# Public URL of the deployed Rust data service. Required for production builds.
VITE_RUST_BACKEND_URL=

# Optional footer links. Leave empty to use the defaults.
VITE_SOCIAL_X=
VITE_SOCIAL_TELEGRAM=
VITE_SOCIAL_GITHUB=
