# Web app (Vite). Copy to .env.local for local work.
#
# You do not need any of these.
#   * On Vercel the data API is a function on the same site, behind /api.
#   * In development Vite proxies /api and /ws to the Rust service on http://127.0.0.1:4000.

# Only set this when the Rust service is hosted somewhere else.
VITE_RUST_BACKEND_URL=

# Optional footer links. Leave empty to use the defaults.
VITE_SOCIAL_X=
VITE_SOCIAL_TELEGRAM=
VITE_SOCIAL_GITHUB=
